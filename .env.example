# Generate private local values with scripts/init-env.ps1. Never commit .env.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=enterprise_agent
MYSQL_USER=agent_app
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MILVUS_URI=http://milvus:19530
CHECKPOINT_MODE=memory
CHECKPOINT_SQLITE_PATH=/app/runtime/checkpoints.sqlite
MAX_TOOL_ITERATIONS=8
MAX_REPAIR_ATTEMPTS=3
MAX_ANSWER_REVISIONS=1
LLM_PROVIDER=remote
LLM_BASE_URL=https://api.openai.com/v1
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LOCAL_LLM_STREAMING=false
LOCAL_LLM_STRUCTURED_OUTPUT=false
LOCAL_LLM_TOOL_CALLING=false
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
