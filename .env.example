# ============================================================================
# 环境变量模板（本文件只含占位值，真实密钥写入 .env，.env 已被 Git 忽略）
# ============================================================================
#
# 真实模型与密钥路径速查：
#   1) 真实大模型（OpenAI 兼容接口）：LLM_PROVIDER=remote
#      需要同时配置：LLM_BASE_URL（接口地址）、LLM_API_KEY（真实密钥）、LLM_MODEL（模型名）
#   2) 本地大模型（如 Ollama，默认不开机启动）：LLM_PROVIDER=local
#      需要：LOCAL_LLM_BASE_URL，并按实际能力设置 LOCAL_LLM_* 三个开关
#   3) 真实向量模型（MVP 为硅基流动）：EMBEDDING_PROVIDER=siliconflow
#      需要同时配置：EMBEDDING_BASE_URL、EMBEDDING_MODEL、EMBEDDING_DIMENSION、EMBEDDING_API_KEY
#   4) 离线验收（无密钥，可复现）：LLM_PROVIDER=extractive + EMBEDDING_PROVIDER=deterministic
#      （由 scripts/dev-env.ps1 自动设置，不要用于生产/真实回答）
#
# 容器说明：backend 容器只透传 compose.yaml `backend.environment` 中列出的变量；
# 未列出的（如保留策略项）需先在 compose.yaml 补映射，或只在宿主脚本中使用。
# ============================================================================

# ---- MySQL（Docker Compose 内的应用数据库）-------------------------------
# 数据：MySQL root 管理员密码（仅用于初始化与只读账号引导），由 scripts/init-env.ps1 随机生成
MYSQL_ROOT_PASSWORD=
# 数据：应用账号 agent_app 的密码（业务表读写），由 init-env.ps1 生成
MYSQL_PASSWORD=
# 数据：应用数据库名
MYSQL_DATABASE=enterprise_agent
# 数据：应用账号用户名
MYSQL_USER=agent_app
# 数据：SQL Agent 专用只读账号用户名（仅执行经 SQL Validator 校验的只读查询）
MYSQL_READONLY_USER=agent_readonly
# 数据：只读账号密码（容器启动时由 backend 用 root 引导创建），由 init-env.ps1 生成
MYSQL_READONLY_PASSWORD=
# 数据：MinIO（Milvus 对象存储后端）访问键，由 init-env.ps1 生成
MINIO_ACCESS_KEY=
# 数据：MinIO 密钥，由 init-env.ps1 生成
MINIO_SECRET_KEY=
# 数据：MySQL 主机名（容器间固定为服务名 mysql；宿主脚本由 dev-env.ps1 改为 127.0.0.1）
MYSQL_HOST=mysql
# 数据：MySQL 容器内端口
MYSQL_PORT=3306
# 数据：MySQL 发布到宿主的端口（宿主 3306 被无关服务占用，故用 13306）
MYSQL_HOST_PORT=13306
# ---- Milvus 向量库 --------------------------------------------------------
# 数据：Milvus 连接地址（容器间用服务名；宿主脚本改为 http://127.0.0.1:19530）
MILVUS_URI=http://milvus:19530
# 数据：Milvus 发布到宿主的端口
MILVUS_HOST_PORT=19530
# ---- Checkpoint（LangGraph 可恢复执行状态）--------------------------------
# 数据：Checkpoint 模式，memory（内存）或 sqlite（可跨重启，MVP 允许的两种）
CHECKPOINT_MODE=memory
# 数据：sqlite 模式下的 Checkpoint 文件路径（容器内指向挂载卷）
CHECKPOINT_SQLITE_PATH=/app/runtime/checkpoints.sqlite
# ---- 有界执行预算（三个独立计数器，改动需契约评审）--------------------------
# 数据：SQL Agent 工具循环次数上限（默认 8）
MAX_TOOL_ITERATIONS=8
# 数据：同一问题自动修复次数上限（默认 3，只允许 llm_unavailable / retrieval_unavailable）
MAX_REPAIR_ATTEMPTS=3
# 数据：单个回答候选的答案修订次数上限（默认 1，登记在 answer_revision_count 字段）
MAX_ANSWER_REVISIONS=1
# ---- 大模型（真实模型路径见文件顶部速查）-----------------------------------
# 数据：LLM 提供方，remote（真实远程）、local（本地服务）、mock（测试桩）、extractive（离线取证阅读器）
LLM_PROVIDER=remote
# 数据：远程 LLM 的 OpenAI 兼容接口地址（真实模型必需）
LLM_BASE_URL=https://api.openai.com/v1
# 数据：本地 LLM 的 OpenAI 兼容接口地址（LOCAL_LLM_BASE_URL，默认指向 Ollama）
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# 数据：远程 LLM 的真实 API Key（密钥；留空时 /chat 路径按预期安全失败，不执行企业查询）
LLM_API_KEY=
# 数据：LLM 模型名（需与所选提供方匹配）
LLM_MODEL=gpt-4o-mini
# 数据：LLM 请求超时秒数
LLM_TIMEOUT_SECONDS=30
# 数据：结构化数据 Agent 的模型选择，auto（跟随 LLM 配置）、llm（强制真实工具调用）、scripted（确定性脚本）
SQL_AGENT_PROVIDER=auto
# 数据：本地模型能力开关：是否支持流式输出（需与真实能力一致，否则边界会安全拒绝）
LOCAL_LLM_STREAMING=false
# 数据：本地模型能力开关：是否支持结构化输出
LOCAL_LLM_STRUCTURED_OUTPUT=false
# 数据：本地模型能力开关：是否支持工具调用（关闭时结构化路径会被显式拒绝）
LOCAL_LLM_TOOL_CALLING=false
# ---- 向量模型（Embedding，真实模型路径见文件顶部速查）----------------------
# 数据：向量提供方，siliconflow（真实远程）或 deterministic（离线可复现，仅验收用）
EMBEDDING_PROVIDER=siliconflow
# 数据：向量接口地址（真实向量模型必需）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 数据：向量模型名（与集合名绑定，改动会使旧集合不再命中）
EMBEDDING_MODEL=BAAI/bge-m3
# 数据：向量维度（必须与模型一致；与模型名一起决定 Milvus 集合名）
EMBEDDING_DIMENSION=1024
# 数据：向量服务的真实 API Key（密钥；缺失时容器内索引/检索按预期安全失败）
EMBEDDING_API_KEY=
# ---- 文档解析器 ------------------------------------------------------------
# 数据：解析器提供方，lightweight（内置轻量解析）或 mineru（mineru.net v4 云解析）
PARSER_PROVIDER=lightweight
# 数据：mineru.net v4 云解析 API 基地址（适配器自动拼接 /file-urls/batch 与 /extract-results/batch/{batch_id}）
MINERU_BASE_URL=https://mineru.net/api/v4
# 数据：MinerU 云解析 Token（密钥，https://mineru.net/apiManage/token 申请；仅 PARSER_PROVIDER=mineru 时使用）
MINERU_API_KEY=
# 数据：MinerU 模型版本，pipeline（默认）或 vlm（更高精度、更慢）
MINERU_MODEL_VERSION=pipeline
# ---- SQL 安全与结果上限（SQL Validator 边界）-------------------------------
# 数据：单次查询最大返回行数
SQL_MAX_ROWS=100
# 数据：单条 SQL 执行超时秒数
SQL_QUERY_TIMEOUT_SECONDS=10
# 数据：允许的最大 JOIN 数
SQL_MAX_JOINS=3
# 数据：允许的最大子查询数
SQL_MAX_SUBQUERIES=2
# 数据：SQL 复杂度评分上限
SQL_MAX_COMPLEXITY_SCORE=60
# 数据：允许访问的表白名单（逗号分隔；其余表一律拒绝）
ALLOWED_TABLES=sales_orders,procurement_orders,products
# 数据：需要掩码的敏感列（逗号分隔；出库与导出都会被屏蔽）
MASKED_COLUMNS=customer_contact,contact_phone,contact_email
# 数据：结构化数据源标识
DATA_SOURCE_ID=demo_sales
# ---- 认证与审批 ------------------------------------------------------------
# 数据：登录会话有效期秒数
AUTH_SESSION_TTL_SECONDS=43200
# 数据：演示/首启账号用户名（仅首次创建，不会覆盖已有用户）
AUTH_BOOTSTRAP_USERNAME=demo
# 数据：演示账号密码（密码；由 init-env.ps1 生成；轮换方法见 docs/OPERATIONS_RUNBOOK.md）
AUTH_BOOTSTRAP_PASSWORD=
# 数据：高风险导出审批的有效期秒数（到期自动 expired，不能 Resume）
APPROVAL_EXPIRY_SECONDS=1800
# ---- 服务端口与日志 --------------------------------------------------------
# 数据：backend 发布到宿主的端口
BACKEND_PORT=8000
# 数据：frontend 发布到宿主的端口
FRONTEND_PORT=5173
# 数据：日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO