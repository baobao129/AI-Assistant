# Generate private local values with scripts/init-env.ps1. Never commit .env.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=enterprise_agent
MYSQL_USER=agent_app
# Read-only account used only by the SQL Agent query path (validated SQL only).
MYSQL_READONLY_USER=agent_readonly
MYSQL_READONLY_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=13306
MILVUS_URI=http://milvus:19530
MILVUS_HOST_PORT=19530
CHECKPOINT_MODE=memory
CHECKPOINT_SQLITE_PATH=/app/runtime/checkpoints.sqlite
MAX_TOOL_ITERATIONS=8
MAX_REPAIR_ATTEMPTS=3
MAX_ANSWER_REVISIONS=1
LLM_PROVIDER=remote
LLM_BASE_URL=https://api.openai.com/v1
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LOCAL_LLM_STREAMING=false
LOCAL_LLM_STRUCTURED_OUTPUT=false
LOCAL_LLM_TOOL_CALLING=false
# Embedding provider (SiliconFlow is the MVP remote provider).
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=
# Parser provider: lightweight (development fallback) or mineru.
PARSER_PROVIDER=lightweight
MINERU_BASE_URL=http://mineru:8000
# SQL security and result limits.
SQL_MAX_ROWS=100
SQL_QUERY_TIMEOUT_SECONDS=10
SQL_MAX_JOINS=3
SQL_MAX_SUBQUERIES=2
SQL_MAX_COMPLEXITY_SCORE=60
ALLOWED_TABLES=sales_orders,procurement_orders,products
MASKED_COLUMNS=customer_contact,contact_phone,contact_email
DATA_SOURCE_ID=demo_sales
# Authentication and approval windows.
AUTH_SESSION_TTL_SECONDS=43200
AUTH_BOOTSTRAP_USERNAME=demo
AUTH_BOOTSTRAP_PASSWORD=
APPROVAL_EXPIRY_SECONDS=1800
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
